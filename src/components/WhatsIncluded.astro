---
import LockScreenWidget from './LockScreenWidget.astro';
import PauseButton from './PauseButton.astro';
import VoiceWave from './VoiceWave.astro';

const chartWidth = 340;
const chartHeight = 57;
const weeklyRecordY = [49, 46, 43, 37, 37, 27, 15, 2];

const chartLine = weeklyRecordY
  .map((y, week) => {
    const x = (week * chartWidth) / (weeklyRecordY.length - 1);
    return `${week === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y}`;
  })
  .join(' ');
const chartArea = `${chartLine} L${chartWidth} ${chartHeight} L0 ${chartHeight} Z`;

const themeBars = [38, 100, 60];
const devices = ['phone', 'phone', 'computer'];
---

<section class="included" aria-labelledby="included-title">
  <div class="page-width">
    <p class="section-eyebrow">Lo que incluye</p>
    <h2 id="included-title" class="section-title">
      Pensada para entrenar con el móvil en la mano. O en el bolsillo.
    </h2>

    <ul class="cards">
      <li class="card voice">
        <div class="copy">
          <h3>Te guía con voz</h3>
          <p>
            Avisos en cada cambio, cuenta atrás y vibración. Entrenas sin mirar
            la pantalla.
          </p>
        </div>
        <VoiceWave id="voice-wave" />
        <div class="pause">
          <PauseButton controls="voice-wave" />
        </div>
      </li>

      <li class="card lock">
        <div class="copy">
          <h3>En la pantalla bloqueada</h3>
          <p>
            En iOS la sesión sigue en la pantalla bloqueada y en la Dynamic
            Island.
          </p>
        </div>
        <LockScreenWidget />
      </li>

      <li class="card free">
        <div class="copy">
          <h3>Entreno libre</h3>
          <p>Empieza sin preparar nada. Al terminar, guárdalo como rutina.</p>
        </div>
        <p class="save">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.4 6.3 4.8 8.6 9.6 3.6"></path>
          </svg>
          Guardar como rutina
        </p>
      </li>

      <li class="card record">
        <div class="copy">
          <div class="record-heading">
            <h3>Récords de fuerza</h3>
            <p class="record-figure">81 kg</p>
          </div>
          <p>Tu 1RM estimado en press banca, semana a semana.</p>
        </div>
        <div class="chart" aria-hidden="true">
          <div class="chart-reveal">
            <svg
              class="chart-drawing"
              viewBox={`0 0 ${chartWidth} ${chartHeight}`}
              preserveAspectRatio="none"
            >
              <defs>
                <linearGradient id="record-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop class="chart-fill-top" offset="0"></stop>
                  <stop class="chart-fill-bottom" offset="1"></stop>
                </linearGradient>
              </defs>
              <path class="chart-area" d={chartArea}></path>
              <path class="chart-line" d={chartLine}></path>
            </svg>
          </div>
        </div>
      </li>

      <li class="card theme">
        <div class="copy">
          <h3>Claro u oscuro</h3>
          <p>Sigue el ajuste de tu móvil, o elige el que prefieras.</p>
        </div>
        <div class="theme-preview" aria-hidden="true">
          {['light', 'dark'].map((tone) => (
            <span class:list={['theme-half', tone]}>
              {themeBars.map((height) => (
                <span class="theme-bar" style={{ '--height': `${height}%` }} />
              ))}
            </span>
          ))}
        </div>
      </li>

      <li class="card account">
        <div class="copy">
          <h3>Cuenta opcional</h3>
          <p>
            Empieza sin registrarte. Si creas cuenta, tus rutinas y tu progreso
            te siguen de un dispositivo a otro.
          </p>
        </div>
        <div class="devices" aria-hidden="true">
          {devices.map((device) => (
            <span class:list={['device', device]}>
              <span class="device-logo">
                <span />
                <span />
                <span />
              </span>
            </span>
          ))}
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .included {
    padding-block: 13px 48px;
  }

  .section-title {
    margin-top: 8px;
  }

  .cards {
    display: grid;
    gap: 16px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--feature-card-border);
    border-radius: 28px;
    background: var(--feature-card-bg);
  }

  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.01em;
  }

  .copy p {
    margin-top: 6px;
    color: var(--sub);
    font-size: 15px;
    line-height: 23px;
  }

  .voice :global(.voice-sample) {
    margin-top: 20px;
  }

  .pause {
    position: absolute;
    top: 21px;
    right: 21px;
    line-height: 0;
  }

  .lock :global(.widget) {
    margin-top: 14px;
  }

  .save {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    align-self: start;
    height: 38px;
    margin-top: 8px;
    padding: 0 18px;
    border-radius: 19px;
    background: var(--ink);
    color: var(--ink-inverse);
    font-size: 14px;
    font-weight: 700;
  }

  .save svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .record-heading {
    display: flex;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
  }

  .copy .record-figure {
    margin: 0;
    color: var(--record-figure);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 800;
    line-height: 24px;
  }

  .chart {
    height: 57px;
    margin-top: 14px;
    view-timeline: --record-chart block;
  }

  .chart-reveal {
    --stroke-room: 3px;

    height: calc(100% + 2 * var(--stroke-room));
    margin: calc(-1 * var(--stroke-room));
    padding: var(--stroke-room);
    overflow: hidden;
  }

  .chart-drawing {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .chart-area {
    fill: url(#record-fill);
  }

  .chart-fill-top,
  .chart-fill-bottom {
    stop-color: var(--record-line);
    stop-opacity: 0.35;
  }

  .chart-fill-bottom {
    stop-opacity: 0;
  }

  .chart-line {
    fill: none;
    stroke: var(--record-line);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .theme-preview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    height: 60px;
    margin-top: 8px;
    overflow: hidden;
    border: 1px solid var(--feature-card-border);
    border-radius: 14px;
  }

  .theme-half {
    display: flex;
    gap: 3px;
    align-items: end;
    padding: 10px;
  }

  .theme-half.light {
    --theme-bar: #2457ff;

    background: var(--theme-preview-light);
  }

  .theme-half.dark {
    --theme-bar: #5b80ff;

    background: var(--theme-preview-dark);
  }

  .theme-bar {
    flex: 1;
    height: var(--height);
    border-radius: 3px;
    background: var(--theme-bar);
    opacity: 0.5;
  }

  .theme-bar:nth-child(2) {
    opacity: 1;
  }

  .theme-bar:nth-child(3) {
    opacity: 0.7;
  }

  .account {
    padding-bottom: 16px;
  }

  .devices {
    display: flex;
    gap: 10px;
    align-self: center;
    margin-top: 20px;
  }

  .device {
    display: flex;
    align-items: end;
    justify-content: center;
    width: 34px;
    height: 61px;
    padding-bottom: 8px;
    border: 1px solid var(--device-border);
    border-radius: 10px;
    background: var(--device-bg);
  }

  .device.computer {
    width: 92px;
  }

  .device-logo {
    display: flex;
    gap: 2px;
    align-items: end;
    height: 15px;
  }

  .device-logo span {
    width: 4px;
    height: 58%;
    border-radius: 2px;
    background: var(--intervals-chart);
    opacity: 0.5;
  }

  .device-logo span:nth-child(2) {
    height: 100%;
    opacity: 1;
  }

  .device-logo span:nth-child(3) {
    height: 76%;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .voice:hover :global(.bar) {
      animation-play-state: paused;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .chart-reveal,
      .chart-drawing {
        animation-name: chart-reveal;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --record-chart;
        animation-range: entry 100% cover 50%;
      }

      .chart-drawing {
        animation-name: chart-counter-reveal;
      }
    }
  }

  @keyframes chart-reveal {
    from {
      transform: translateX(-100%);
    }
  }

  @keyframes chart-counter-reveal {
    from {
      transform: translateX(calc(100% + 2 * var(--stroke-room)));
    }
  }

  @media (min-width: 640px) {
    .voice,
    .account {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 24px;
      align-items: center;
    }

    .voice .copy {
      max-width: 300px;
    }

    .voice :global(.voice-sample) {
      width: 362px;
      margin-top: 0;
    }

    .account {
      padding-bottom: 24px;
    }

    .account .copy {
      max-width: 360px;
    }

    .devices {
      margin-top: 0;
    }

    .lock :global(.widget),
    .theme-preview {
      max-width: 342px;
    }
  }

  @media (min-width: 960px) {
    .included {
      padding-block: 35px 72px;
    }
  }

  @media (min-width: 1100px) {
    .section-title {
      max-width: 720px;
    }

    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(229px, auto));
      grid-template-areas:
        'voice voice lock'
        'free record lock'
        'theme account account';
    }

    .voice {
      grid-area: voice;
    }

    .lock {
      grid-area: lock;
    }

    .free {
      grid-area: free;
    }

    .record {
      grid-area: record;
    }

    .theme {
      grid-area: theme;
    }

    .account {
      grid-area: account;
    }

    .lock :global(.widget),
    .save,
    .chart,
    .theme-preview {
      margin-top: auto;
    }

    .lock :global(.widget),
    .theme-preview {
      max-width: none;
    }
  }
</style>
