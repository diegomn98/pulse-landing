---
import StoreBadges from './StoreBadges.astro';
---

<section class="availability" aria-labelledby="availability-title">
  <div class="page-width">
    <div class="card">
      <div>
        <h2 id="availability-title">Llega a iOS, Android y web.</h2>
        <p>
          Tu cuenta y tus rutinas te siguen de un sitio a otro. Dinos dónde la
          usarás y te avisamos allí primero.
        </p>
      </div>
      <StoreBadges class="badges" size="large" />
    </div>
  </div>
</section>

<style>
  .availability {
    padding-block: 40px 48px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--feature-card-border);
    border-radius: 34px;
    background: var(--feature-card-bg);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    line-height: 32px;
    letter-spacing: -0.035em;
  }

  p {
    margin-top: 10px;
    color: var(--sub);
    font-size: 16px;
    line-height: 23px;
  }

  .card :global(.badges) {
    margin-top: 28px;
  }

  @media (min-width: 640px) {
    .card {
      padding: 40px;
    }

    h2 {
      font-size: 40px;
      line-height: 43px;
    }

    p {
      max-width: 500px;
    }
  }

  @media (min-width: 960px) {
    .availability {
      padding-block: 68px 72px;
    }

    .card {
      flex-direction: row;
      gap: 32px;
      align-items: center;
      justify-content: space-between;
    }

    p {
      margin-top: 9px;
    }

    .card :global(.badges) {
      flex-shrink: 0;
      margin-top: 0;
    }
  }
</style>
