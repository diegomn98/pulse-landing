---
import WaitlistLink from './WaitlistLink.astro';

const barHeights = [
  36, 80, 110, 120, 104, 68, 49, 91, 116, 117, 95, 55, 62, 99, 119, 114, 85, 42,
  74, 108, 120, 108, 73, 43, 85, 114, 119, 99, 61, 56, 96, 117, 115, 90, 48, 68,
  104, 120, 110, 79,
];
---

<section class="closing" aria-labelledby="closing-title">
  <div class="page-width">
    <p class="motto">
      Sin días fijos. Sin presión. <span class="accent">Solo lo que toca.</span>
    </p>
    <div class="card">
      <h2 id="closing-title" class="section-title title">
        Sé de los primeros en probarla.
      </h2>
      <p class="lead">
        Déjanos tu email y te avisamos el día que salga. Nada más.
      </p>
      <WaitlistLink class="join">Apuntarme a la lista</WaitlistLink>
      <div class="bars" aria-hidden="true">
        {barHeights.map((height) => (
          <span style={{ height: `${height}px` }} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: 47px 44px;
  }

  .motto {
    max-width: 1000px;
    margin-inline: auto;
    color: var(--motto-muted);
    font-family: var(--font-display);
    font-size: clamp(40px, 3.43vw + 26.6px, 76px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-align: center;
  }

  .accent {
    background: var(--motto-accent);
    background-clip: text;
    color: transparent;
  }

  .card {
    position: relative;
    overflow: hidden;
    margin-top: 95px;
    padding: 44px 24px 120px;
    border-radius: 40px;
    background: var(--intervals-gradient);
    box-shadow: var(--closing-card-shadow);
    color: #fff;
    text-align: center;
  }

  .title,
  .lead {
    max-width: 540px;
    margin-inline: auto;
  }

  .lead {
    margin-top: 15px;
    font-size: 17px;
    line-height: 26px;
  }

  .join {
    display: inline-grid;
    align-items: center;
    height: 58px;
    margin-top: 20px;
    padding: 0 30px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--closing-button-shadow);
    color: var(--intervals-deep);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    text-decoration: none;
  }

  .join:focus-visible {
    outline-color: #fff;
    outline-offset: 3px;
  }

  .bars {
    position: absolute;
    inset: auto 20px 0;
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }

  .bars span {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: var(--closing-bar);
  }

  @media (min-width: 640px) {
    .lead {
      font-size: 20px;
      line-height: 31px;
    }
  }

  @media (min-width: 960px) {
    .closing {
      padding-block: 88px 70px;
    }

    .card {
      margin-top: 111px;
      padding: 80px 40px 140px;
    }
  }
</style>
