<button
  type="button"
  class="theme-toggle"
  aria-label="Modo oscuro"
  aria-pressed="false"
>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
  </svg>
</button>

<script>
  import { setupThemeToggle } from '../scripts/theme';

  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (toggle) setupThemeToggle(toggle);
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--card-border);
    border-radius: 50%;
    background: var(--pill);
    color: var(--ink);
    cursor: pointer;
  }

  .icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sun,
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
