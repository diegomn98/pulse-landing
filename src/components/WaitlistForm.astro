---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const emailId = 'waitlist-email';
const platformsLabelId = 'waitlist-platforms-label';

const platforms = [
  { label: 'iOS', pressed: true },
  { label: 'Android', pressed: false },
  { label: 'Web', pressed: false },
];
---

<form {id} class="waitlist">
  <div class="fields">
    <label class="visually-hidden" for={emailId}>
      Tu email
    </label>
    <input
      id={emailId}
      class="email"
      type="email"
      name="email"
      autocomplete="email"
      placeholder="tu@email.com"
      required
    />
    <button class="submit" type="submit">
      Apuntarme
    </button>
  </div>
  <div class="platforms" role="group" aria-labelledby={platformsLabelId}>
    <span id={platformsLabelId} class="platforms-label">
      ¿Dónde la usarás?
    </span>
    {platforms.map(({ label, pressed }) => (
      <button
        class="platform"
        type="button"
        aria-pressed={pressed ? 'true' : 'false'}
      >
        {label}
      </button>
    ))}
  </div>
</form>

<style>
  .fields {
    display: grid;
    gap: 10px;
  }

  .email {
    min-width: 0;
    height: 58px;
    padding: 0 22px;
    border: 1.5px solid var(--input-border);
    border-radius: 999px;
    background: var(--pill);
    color: var(--ink);
    font: inherit;
    font-size: 17px;
  }

  .email::placeholder {
    color: var(--sub);
    opacity: 1;
  }

  .email:focus-visible {
    outline-offset: 3px;
  }

  .submit {
    height: 58px;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: var(--intervals-gradient);
    box-shadow: var(--intervals-shadow);
    color: #fff;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
  }

  .submit:focus-visible {
    outline-offset: 3px;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  .platforms-label {
    margin-right: 2px;
    color: var(--sub);
    font-size: 14px;
  }

  .platform {
    position: relative;
    min-width: 44px;
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--input-border);
    border-radius: 999px;
    background: var(--chip);
    color: var(--ink);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  .platform::before {
    content: '';
    position: absolute;
    inset: -5px 0;
  }

  .platform[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--ink-inverse);
  }

  @media (min-width: 640px) {
    .fields {
      grid-template-columns: minmax(0, 1fr) auto;
      max-width: 520px;
    }
  }
</style>
