---
import PauseButton from './PauseButton.astro';
import type { TrainingType } from './training-type';

type TickerPill = TrainingType | 'own';

interface TickerExercise {
  name: string;
  pill: TickerPill;
}

interface TickerRow {
  direction: 'left' | 'right';
  seconds: number;
  exercises: TickerExercise[];
}

const rows: TickerRow[] = [
  {
    direction: 'left',
    seconds: 60,
    exercises: [
      { name: 'Press banca', pill: 'strength' },
      { name: 'Sentadilla con salto', pill: 'intervals' },
      { name: 'Peso muerto rumano', pill: 'strength' },
      { name: 'Escaladores', pill: 'intervals' },
      { name: 'Remo con barra', pill: 'strength' },
      { name: 'Zancadas alternas', pill: 'intervals' },
      { name: 'Press militar', pill: 'strength' },
      { name: 'Burpees', pill: 'intervals' },
      { name: 'Dominadas', pill: 'strength' },
      { name: 'Remo en anillas', pill: 'own' },
    ],
  },
  {
    direction: 'right',
    seconds: 70,
    exercises: [
      { name: 'Flexiones', pill: 'intervals' },
      { name: 'Elevaciones laterales', pill: 'strength' },
      { name: 'Series de 400 m', pill: 'running' },
      { name: 'Curl de bíceps', pill: 'strength' },
      { name: 'Fondos', pill: 'strength' },
      { name: 'Rodaje suave', pill: 'running' },
      { name: 'Remo en polea baja', pill: 'strength' },
      { name: 'Sentadilla', pill: 'strength' },
      { name: 'Fartlek', pill: 'running' },
      { name: 'Crea el tuyo', pill: 'own' },
    ],
  },
];

const copies = 3;
---

<div id="exercise-ticker" class="ticker">
  <div class="rows">
    {rows.map(({ direction, seconds, exercises }) => (
      <div
        class:list={['track', direction]}
        style={{ '--copies': copies, '--seconds': `${seconds}s` }}
      >
        {Array.from({ length: copies }, (_, copy) => (
          <ul class="names" aria-hidden={copy > 0 ? 'true' : undefined}>
            {exercises.map(({ name, pill }) => (
              <li class:list={['name', pill]}>
                {pill === 'own' && (
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M6 1.5v9M1.5 6h9" />
                  </svg>
                )}
                {name}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))}
  </div>
  <div class="page-width pause">
    <PauseButton controls="exercise-ticker" />
  </div>
</div>

<style>
  .ticker {
    --gap: 10px;
  }

  .rows {
    display: grid;
    gap: 12px;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 10%,
      #000 90%,
      transparent
    );
  }

  .track {
    display: flex;
    width: max-content;
  }

  .names {
    display: flex;
    gap: var(--gap);
    padding: 0 var(--gap) 0 0;
    list-style: none;
  }

  .name {
    display: flex;
    gap: 9px;
    align-items: center;
    height: 48px;
    padding: 0 18px 0 15px;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: var(--card);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .name::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
  }

  .intervals {
    --dot: var(--intervals-chart);
  }

  .running {
    --dot: var(--running-chart);
  }

  .strength {
    --dot: var(--strength-chart);
  }

  .own {
    border-color: transparent;
    background: #fff;
    color: #0e1726;
  }

  .own::before {
    display: none;
  }

  .own svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .pause {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: ticker-left var(--seconds) linear infinite;
    }

    .track.right {
      animation-name: ticker-right;
    }

    .rows:hover .track {
      animation-play-state: paused;
    }
  }

  @keyframes ticker-left {
    to {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }

  @keyframes ticker-right {
    from {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }
</style>
