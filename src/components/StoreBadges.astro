---
interface Props {
  class?: string;
  size?: 'regular' | 'large';
}

const { class: className, size = 'regular' } = Astro.props;

const stores = ['App Store', 'Google Play'];
---

<ul class:list={['stores', size, className]}>
  {stores.map((store) => (
    <li class="badge">
      <span class="soon">Próximamente en</span>
      <span class="store">{store}</span>
    </li>
  ))}
</ul>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .badge {
    display: grid;
    align-content: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--store-badge-border);
    border-radius: 9px;
    background: #000;
    color: #fff;
  }

  .soon {
    font-size: 10px;
    font-weight: 600;
    line-height: 1.2;
  }

  .store {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .large {
    gap: 12px;
  }

  .large .badge {
    min-height: 52px;
  }

  .large .store {
    font-size: 18px;
  }

  @media (min-width: 640px) {
    .badge {
      min-height: 54px;
      padding: 0 18px;
      border-radius: 10px;
    }

    .soon {
      font-size: 11px;
    }

    .store {
      font-size: 20px;
    }

    .large .badge {
      min-height: 60px;
    }

    .large .store {
      font-size: 21px;
    }
  }
</style>
