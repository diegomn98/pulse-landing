---
interface Bar {
  height: number;
  muted?: boolean;
}

interface TrainingTypeCard {
  type: 'intervals' | 'running' | 'strength';
  kicker: string;
  name: string;
  description: string;
  features: string[];
  barGroups: Bar[][];
}

const tall: Bar = { height: 64 };
const rest = (height: number): Bar => ({ height, muted: true });

const intervalsBars = Array.from({ length: 28 }, (_, index) =>
  index % 2 === 1 ? tall : rest(index % 14 === 0 ? 35 : 22),
);

const runningBars = [
  rest(32),
  rest(32),
  ...Array.from({ length: 12 }, (_, index) =>
    index % 2 === 0 ? tall : rest(15),
  ),
  rest(32),
];

const strengthBarGroups = [4, 4, 3, 3, 3].map((sets) =>
  [59, 55, 51, 47].slice(0, sets).map((height) => ({ height })),
);

const cards: TrainingTypeCard[] = [
  {
    type: 'intervals',
    kicker: 'Cronómetro guiado',
    name: 'Intervalos',
    description:
      'HIIT, tabata y circuitos con una voz que te cuenta cada cambio. La pantalla se llena mientras trabajas.',
    features: [
      'Trabajo, descanso y rondas a tu medida',
      'Ves el siguiente ejercicio de un vistazo',
      'Intervalos libres que se guardan como rutina',
    ],
    barGroups: [intervalsBars],
  },
  {
    type: 'running',
    kicker: 'Con GPS',
    name: 'Running',
    description:
      'Series, rodajes y fartlek con ritmo objetivo. Te avisa si te desvías, sin mirar el móvil.',
    features: [
      'Tramos por distancia o por tiempo',
      'Ritmo y distancia en directo',
      'Tu carrera libre, convertida en rutina',
    ],
    barGroups: [runningBars],
  },
  {
    type: 'strength',
    kicker: 'Series y pesos',
    name: 'Fuerza',
    description:
      'Apunta series y kilos como en una libreta, con los pesos de la última vez ya escritos.',
    features: [
      'Descansos automáticos',
      'Si la máquina está ocupada, la cambias',
      'Récords y progreso de cada ejercicio',
    ],
    barGroups: strengthBarGroups,
  },
];
---

<section id="tipos" class="types" aria-labelledby="types-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="page-width">
    <p class="eyebrow">Una sola app</p>
    <h2 id="types-title" class="title">
      <span>Tres formas de entrenar.</span> <span>Cada una con su color.</span>
    </h2>
    <ul class="cards">
      {cards.map(({ type, kicker, name, description, features, barGroups }) => (
        <li class:list={['card', type]}>
          <article aria-labelledby={`${type}-name`}>
            <p class="kicker">{kicker}</p>
            <h3 id={`${type}-name`} class="name">
              {name}
            </h3>
            <div class="chart" aria-hidden="true">
              {barGroups.map((group) => (
                <span class="bar-group" style={{ '--bars': group.length }}>
                  {group.map(({ height, muted }) => (
                    <span
                      class:list={['bar', { muted }]}
                      style={{ height: `${height}px` }}
                    />
                  ))}
                </span>
              ))}
            </div>
            <p class="description">{description}</p>
            <ul class="features">
              {features.map((feature) => (
                <li>
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 6.4 4.8 9 10 3.2" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .types {
    position: relative;
    overflow-x: clip;
    padding-block: 12px 50px;
  }

  .glow {
    position: absolute;
    inset: -400px 0 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 300px 420px at 100% 810px,
      var(--types-glow) 20%,
      transparent
    );
    pointer-events: none;
  }

  .eyebrow {
    color: var(--intervals-accent);
    font-size: 12px;
    font-weight: 800;
    line-height: 16px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(36px, 3.5vw + 22.5px, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .cards {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  .card {
    border-radius: 28px;
    color: #fff;
  }

  .card.intervals {
    background: var(--intervals-gradient);
    box-shadow: var(--intervals-card-shadow);
  }

  .card.running {
    background: var(--running-gradient);
    box-shadow: var(--running-card-shadow);
  }

  .card.strength {
    background: var(--strength-gradient);
    box-shadow: var(--strength-card-shadow);
  }

  article {
    padding: 25px 24px 28px;
  }

  .kicker {
    font-size: 11px;
    font-weight: 800;
    line-height: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .name {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .chart {
    display: flex;
    gap: 20px;
    align-items: flex-end;
    height: 64px;
    margin-top: 17px;
  }

  .bar-group {
    display: flex;
    flex: var(--bars) 1 calc((var(--bars) - 1) * 3px);
    gap: 3px;
    align-items: flex-end;
  }

  .bar {
    flex: 1;
    border-radius: 3px;
    background: #fff;
  }

  .bar.muted {
    opacity: 0.38;
  }

  .description {
    margin-top: 16px;
    font-size: 16px;
    line-height: 24px;
  }

  .features {
    display: grid;
    gap: 7px;
    margin-top: 14px;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }

  .features li {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .features svg {
    flex: none;
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 640px) {
    .title span {
      display: block;
    }
  }

  @media (min-width: 960px) {
    .types {
      padding-block: 35px 86px;
    }

    .glow {
      background: radial-gradient(
        ellipse 540px 470px at 100% 580px,
        var(--types-glow) 25%,
        transparent
      );
    }

    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }
</style>
